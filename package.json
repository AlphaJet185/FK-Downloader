{
  "name": "fk-downloader",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nodemon server.js",
    "start": "node server.js",
    "vite": "vite",
    "build": "vite build",
    "build:with-yt-dlp": "vite build",
    "preview": "vite preview",
    "desktop:dev": "electron electron/main.js",
    "desktop:pack": "vite build && electron-builder --dir",
    "desktop:build": "vite build && electron-builder",
    "tunnel:quick": "cloudflared tunnel --url http://localhost:3000",
    "tunnel:run": "cloudflared tunnel --config .cloudflared/config.yml run",
    "lint": "tsc --noEmit",
    "clean": "rd /s /q node_modules && del package-lock.json"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "express": "^5.2.1"
  },
  "devDependencies": {
    "@distube/ytdl-core": "^4.16.12",
    "@tailwindcss/postcss": "^4.2.1",
    "@tailwindcss/vite": "^4.2.1",
    "@types/cors": "^2.8.19",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.14.0",
    "@vercel/speed-insights": "^1.3.1",
    "@vitejs/plugin-react": "^5.1.4",
    "autoprefixer": "^10.4.27",
    "axios": "^1.13.6",
    "electron": "^37.3.0",
    "electron-builder": "^26.0.12",
    "better-sqlite3": "^12.4.1",
    "form-data": "^4.0.1",
    "lucide-react": "^0.577.0",
    "motion": "^12.35.1",
    "multer": "^2.0.2",
    "nodemon": "^3.1.14",
    "postcss": "^8.5.8",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "tailwindcss": "^4.2.1",
    "ts-node": "^10.9.2",
    "typescript": "~5.8.2",
    "vite": "^7.3.2",
    "ytdl-core": "^4.11.5"
  },
  "optionalDependencies": {
    "youtube-dl-exec": "^3.1.4"
  },
  "overrides": {
    "path-to-regexp": "^8.4.1",
    "picomatch": "^4.0.4",
    "undici": "^7.24.7"
  },
  "resolutions": {
    "ajv": "^8.12.0",
    "css-what": "^5.0.1",
    "lodash": "^4.17.21",
    "minimatch": "^10.2.2",
    "nth-check": "^2.0.1",
    "path-to-regexp": "^6.2.2",
    "undici": "^6.28.0"
  },
  "description": "Desktop-ready video downloader with offline search, preview, and local downloads.",
  "main": "electron/main.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AlphaJet185/FK-Downloader.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/AlphaJet185/FK-Downloader/issues"
  },
  "engines": {
    "node": "24.x"
  },
  "homepage": "https://github.com/AlphaJet185/FK-Downloader#readme",
  "build": {
    "appId": "com.alphajet.fkdownloader",
    "productName": "FK Downloader",
    "npmRebuild": false,
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "public/**/*",
      "server.js",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "bin",
        "to": "bin",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "signAndEditExecutable": false,
      "target": [
        "nsis"
      ],
      "icon": "static/favicon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
